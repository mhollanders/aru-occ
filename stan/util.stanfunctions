/** 
 * Get first and last survey per site
 *
 * @param Delta  Activity times per survey
 *
 * @return  
 */
array[,] int first_last_survey(data matrix Delta) {
  int I = rows(Delta), J = cols(Delta);
  array[I, 2] int f_l = rep_array(0, I, 2);
  for (i in 1:I) {
    for (j in 1:J) {
      if (Delta[i, j] > 0) {
        f_l[i] = rep_array(j, 2);
        break;
      }
    }
    int JJ = J - f_l[i, 1];
    if (JJ) {
      array[JJ] int idx = linspaced_int_array(JJ, f_l[i, 1] + 1, J);
      for (j in reverse(idx)) {
        if (Delta[i, j] > 0) {
          f_l[i, 2] = j;
          break;
        }
      }
    }
  }
  return f_l;
}

/**
 * Get first and last season per site. 
 *
 * @param Delta  First and last survey per site
 *
 * @return  
 */
array[,] int first_last_season(data array[,,] int f_l) {
  int I = size(f_l), K = size(f_l[1]);
  array[I, 2] int f_l_k;
  for (i in 1:I) {
    for (k in 1:K) {
      if (f_l[i, k, 1]) {
        f_l_k[i] = rep_array(k, 2);
        break;
      }
    }
    int KK = K - f_l_k[i, 1];
    if (KK) {
      array[KK] int idx = linspaced_int_array(KK, f_l_k[i, 1] + 1, K);
      for (k in reverse(idx)) {
        if (f_l[i, k, 1]) {
          f_l_k[i, 2] = k;
          break;
        }
      }
    }
  }
  return f_l_k;
}

/**
 * Log 2x2 transition probability matrix from log transition rates and interval.
 *
 * @param log_q  Log colonisation and emigration rates
 * @param tau    Time interval
 *
 * @return   log(matrix_exp(Q) * tau), where Q  is a 2x2 generator matrix
 */
matrix log_matrix_exp(array[] real log_q, real tau) {
  if (size(log_q) != 2) {
    reject("log_matrix_exp() only works for a 2x2 generator matrix and requires two transition rates.");
  }
  real log_S = log_sum_exp(log_q),
       Stau = exp(log_S) * tau,
       log_1mexp_Stau = log1m_exp(-Stau);
  array[2] real log_pi = { log_q[1] - log_S, log_q[2] - log_S };
  return [[ log_sum_exp(log_pi[2], log_pi[1] - Stau), 
            log_pi[1] + log_1mexp_Stau ],
          [ log_pi[2] + log_1mexp_Stau, 
            log_sum_exp(log_pi[1], log_pi[2] - Stau) ]];
}

/**
 * Elementwise natural logarithm of the product of the elementwise 
 * exponentiation of two matrices
 *
 * @param A  First matrix or (row-)vector
 * @param B  Second matrix or (row-)vector
 *
 * @return   log(exp(A) * exp(B))
 */
matrix log_prod_exp(matrix A, matrix B) {
  int I = rows(A);
  int J = cols(A);
  int K = cols(B);
  matrix[J, I] A_tr = A';
  matrix[I, K] C;
  for (k in 1:K) {
    for (i in 1:I) {
      C[i, k] = log_sum_exp(A_tr[:, i] + B[:, k]);
    }
  }
  return C;
}
vector log_prod_exp(matrix A, vector B) {
  int I = rows(A);
  int J = cols(A);
  matrix[J, I] A_tr = A';
  vector[I] C;
  for (i in 1:I) {
    C[i] = log_sum_exp(A_tr[:, i] + B);
  }
  return C;
}
row_vector log_prod_exp(row_vector A, matrix B) {
  int K = cols(B);
  vector[size(A)] A_tr = A';
  row_vector[K] C;
  for (k in 1:K) {
    C[k] = log_sum_exp(A_tr + B[:, k]);
  }
  return C;
}
real log_prod_exp(row_vector A, vector B) {
  return log_sum_exp(A' + B);
}


/** 
 * Create transition rate matrix from transition rates
 *
 * @param q  Colonisation and emigration rates
 *
 * @return   Transition rate matrix
 */
matrix rate_matrix(array[] real q) {
  return [[ -q[1], q[1]], [ q[2], -q[2] ]];
}

/**
 * Multivariate Gaussian processes (GP) with non-centered paramerisation. Row-
 * and column functions refer to having the GP govern the rows or columns, 
 * respectively, with the remaining dimension governing the correlations. GP
 * scale is fixed at 1 for identifability. Function is overloaded for one- 
 * and multi-dimensional input. 
 *
 * @param x        GP input
 * @param ell      GP length scale
 * @param tau      Multivariate scales
 * @param Omega_L  Lower triangular Cholesky factor of correlation matrix
 * @param z        Standard normal variates
 *
 * @return   Multivariate GP realisations
 */
row_vector column_gp(data array[] real x, real ell, real tau, row_vector z) {
  return z * cholesky_decompose(add_diag(gp_exp_quad_cov(x, tau, ell), 1e-9))';
}
row_vector column_gp(data array[] vector x, real ell, real tau, row_vector z) {
  return z * cholesky_decompose(add_diag(gp_exp_quad_cov(x, tau, ell), 1e-9))';
}

/**
 * Multivariate Gaussian processes (GP) with non-centered paramerisation. Row-
 * and column functions refer to having the GP govern the rows or columns, 
 * respectively, with the remaining dimension governing the correlations. GP
 * scale is fixed at 1 for identifability. Function is overloaded for one- 
 * and multi-dimensional input. 
 *
 * @param x        GP input
 * @param ell      GP length scale
 * @param tau      Multivariate scales
 * @param Omega_L  Lower triangular Cholesky factor of correlation matrix
 * @param z        Standard normal variates
 *
 * @return   Multivariate GP realisations
