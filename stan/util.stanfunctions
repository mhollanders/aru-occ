}
matrix column_multi_gp(data array[] real x, real ell, vector tau, 
                       matrix Omega_L, matrix z) {
  return diag_pre_multiply(tau, Omega_L) * z
         * cholesky_decompose(add_diag(gp_exp_quad_cov(x, 1, ell), 1e-9))';
}
