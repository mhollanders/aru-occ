matrix row_multi_gp(data array[] real x, real ell, vector tau, 
                    matrix Omega_L, matrix z) {
  return cholesky_decompose(add_diag(gp_exp_quad_cov(x, 1, ell), 1e-9))
         * z * diag_post_multiply(Omega_L', tau);
}
matrix row_multi_gp(data array[] vector x, real ell, vector tau, 
                    matrix Omega_L, matrix z) {
  return cholesky_decompose(add_diag(gp_exp_quad_cov(x, 1, ell), 1e-9))
